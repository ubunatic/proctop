{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "proctop config spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "defaults", "keys", "theme", "graph", "labels", "formats", "screenshot", "summary"],
  "properties": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string", "description": "Go text/template; fields: .Target .RootPID .Procs" }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval", "interval_steps", "history", "graph_height", "format"],
      "properties": {
        "interval": { "type": "string", "description": "Go duration string, e.g. 1s" },
        "interval_steps": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "description": "Go duration string" },
          "description": "Ascending ladder of intervals walked by the interval keys"
        },
        "history": { "type": "integer", "minimum": 10 },
        "graph_height": { "type": "integer", "minimum": 1, "maximum": 20 },
        "format": { "enum": ["plain", "color", "json"] }
      }
    },
    "keys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quit", "pause", "screenshot", "interval_up", "interval_down", "cursor_left", "cursor_right", "mark", "annotate"],
      "properties": {
        "quit": { "$ref": "#/definitions/keyList" },
        "pause": { "$ref": "#/definitions/keyList" },
        "screenshot": { "$ref": "#/definitions/keyList" },
        "interval_up": { "$ref": "#/definitions/keyList" },
        "interval_down": { "$ref": "#/definitions/keyList" },
        "cursor_left": { "$ref": "#/definitions/keyList" },
        "cursor_right": { "$ref": "#/definitions/keyList" },
        "mark": { "$ref": "#/definitions/keyList" },
        "annotate": { "$ref": "#/definitions/keyList" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "mem", "label", "dim", "max", "min", "title", "cursor", "select", "annot", "label_bg", "connector"],
      "properties": {
        "cpu": { "$ref": "#/definitions/color256" },
        "mem": { "$ref": "#/definitions/color256" },
        "label": { "$ref": "#/definitions/color256" },
        "dim": { "$ref": "#/definitions/color256" },
        "max": { "$ref": "#/definitions/color256" },
        "min": { "$ref": "#/definitions/color256" },
        "title": { "$ref": "#/definitions/color256" },
        "cursor": { "$ref": "#/definitions/color256" },
        "select": { "$ref": "#/definitions/color256" },
        "annot": { "$ref": "#/definitions/color256" },
        "label_bg": { "$ref": "#/definitions/color256" },
        "connector": { "$ref": "#/definitions/color256" }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels", "marker", "label_width", "label_box", "label_cap", "label_line"],
      "properties": {
        "levels": { "type": "string", "description": "9 runes: empty + 8 partial block levels" },
        "marker": { "type": "string", "minLength": 1, "description": "Glyph at an annotated column when label_cap is none" },
        "label_width": { "type": "integer", "minimum": 4, "description": "Max rune length of in-graph labels" },
        "label_box": { "enum": ["brackets", "box", "none"], "description": "Label boxing: [Test], 3-row box art, or bare text" },
        "label_cap": { "enum": ["none", "simple", "arrow"], "description": "Connector tip pointing at the column; none uses the marker glyph" },
        "label_line": { "enum": ["none", "border", "minus"], "description": "Connector line between label and cap" }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "mem", "procs", "min", "max", "avg", "elapsed", "interval", "hint_quit", "hint_pause", "hint_screenshot", "hint_annotate", "hint_scroll", "hint_interval", "hint_note", "note_prompt", "paused", "scrolled", "saved", "waiting"],
      "properties": {
        "cpu": { "type": "string" },
        "mem": { "type": "string" },
        "procs": { "type": "string" },
        "min": { "type": "string" },
        "max": { "type": "string" },
        "avg": { "type": "string" },
        "elapsed": { "type": "string" },
        "interval": { "type": "string" },
        "hint_quit": { "type": "string" },
        "hint_pause": { "type": "string" },
        "hint_screenshot": { "type": "string" },
        "hint_annotate": { "type": "string" },
        "hint_scroll": { "type": "string" },
        "hint_interval": { "type": "string" },
        "hint_note": { "type": "string" },
        "note_prompt": { "type": "string" },
        "paused": { "type": "string" },
        "scrolled": { "type": "string" },
        "saved": { "type": "string" },
        "waiting": { "type": "string" }
      }
    },
    "formats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plain", "color", "time", "cursor", "annotation"],
      "properties": {
        "plain": { "type": "string", "description": "Go text/template; fields: .Time .CPU .Mem .Procs" },
        "color": { "type": "string", "description": "Like plain; extra funcs: fg <token>, off" },
        "time": { "type": "string", "description": "Go time layout for .Time" },
        "cursor": { "type": "string", "description": "TUI cursor info line; fields: .Time .CPU .Mem" },
        "annotation": { "type": "string", "description": "TUI annotation line; fields: .Time .Span .CPU .Mem .Note" }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "time", "formats"],
      "properties": {
        "name": { "type": "string", "description": "Filename template without extension; fields: .Target .Time" },
        "time": { "type": "string", "description": "Go time layout for .Time; must be filename-safe" },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["txt", "ansi"] }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "description": "Go text/template for the exit summary" }
      }
    }
  },
  "definitions": {
    "color256": { "type": "integer", "minimum": 0, "maximum": 255 },
    "keyList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "description": "Literal key or named alias: <esc> <c-c> <cr> <space>" }
    }
  }
}
